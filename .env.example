# Copier en .env (ignoré par git) et remplacer les valeurs : cp .env.example .env
# Mot de passe de PostgreSQL (base "velov" des prédictions et base "mlflow" du registre)
POSTGRES_PASSWORD=change-me

# UID:GID propriétaire de ./data sur la machine hôte (collecteur bronze). `id -u` / `id -g`
# COLLECTOR_UID=1000
# COLLECTOR_GID=1000

# Serveur MLflow, côté poste : export MLFLOW_TRACKING_URI=http://192.168.1.226:5000
